{
  "name": "vue3-plyr",
  "private": false,
  "version": "1.1.6",
  "author": "Márlon Bento Azevedo (https://github.com/marlon-bento)",
  "repository": {
    "type": "git",
    "url": "https://github.com/marlon-bento/vue3-plyr"
  },
  "description": "Componente Vue 3 moderno e tipado para o player Plyr (Vídeo, Áudio, YouTube, Vimeo)",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/vue3-plyr.umd.cjs",
  "module": "./dist/vue3-plyr.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue3-plyr.js",
      "require": "./dist/vue3-plyr.umd.cjs"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:watch": "vite build --watch",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "plyr": "^3.7.8",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^11.0.1",
    "release-it": "^20.2.1",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "plyr": "^3.7.8",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^4.3.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.0"
  }
}
